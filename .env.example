PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
PG_SSL_REJECT_UNAUTHORIZED=false
CORS_ORIGIN=http://localhost:3000

# Glowy AI (ai-offline engine). Provider: openai, gemini, or disabled.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
# Confirm the key is NEW and has never been pasted/shared before enabling requests.
OPENAI_KEY_ROTATED_CONFIRMED=false
OPENAI_ENABLE_LIVE=false
OPENAI_MAX_CALLS_PER_RUN=20
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_TIMEOUT_MS=25000
# Per provider run (the server starts a new run when the cap is reached).
OPENAI_BUDGET_USD=0.50
# Optional Gemini adapter; never used as an automatic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_ENABLE_LIVE=false
GEMINI_MODEL_ACCESS_CONFIRMED=false
GEMINI_FREE_TIER_CONFIRMED=false
GLOWY_MAX_IMAGE_BYTES=2097152
