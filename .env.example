PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
PG_SSL_REJECT_UNAUTHORIZED=false
CORS_ORIGIN=http://localhost:3000

# Glowy AI (ai-offline engine). Provider: openai, gemini, or disabled.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_VISION_MODEL=gpt-6.1-terra
# Confirm the key is NEW and has never been pasted/shared before enabling requests.
OPENAI_KEY_ROTATED_CONFIRMED=false
OPENAI_ENABLE_LIVE=false
OPENAI_MAX_CALLS_PER_WINDOW=20
OPENAI_CALL_WINDOW_MS=3600000
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_TIMEOUT_MS=25000
# Estimated cumulative budget per Node.js process; process restarts reset this in-memory estimate.
OPENAI_BUDGET_USD=0.50
# Optional Gemini adapter; never used as an automatic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_ENABLE_LIVE=false
GEMINI_MODEL_ACCESS_CONFIRMED=false
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_MAX_CALLS_PER_WINDOW=10
GEMINI_CALL_WINDOW_MS=3600000
GLOWY_MAX_IMAGE_BYTES=2097152
